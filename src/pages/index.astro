---
import '../styles/global.css';
const youtube = 'https://www.youtube.com/channel/UC636G6BGu90hoEgCOoM1i-Q/';
const facebook = 'https://www.facebook.com/profile.php?id=61572474629348';
const instagram = 'https://www.instagram.com/challengingclassics/';
const playlists = [
  { id: 'PLaFcz1FiZloY', thumbnail: '/pyrenees.webp', category: 'ROAD TRIPS', title: 'The Ultimate Pyrenees Porsche Road Trip' },
  { id: 'PLqKCYKuFxHzSNMTn6cGZCOEhfiXMVi0N5', thumbnail: '/boxster-986.jpg', category: 'IN THE GARAGE', title: 'Porsche Boxster 986 2.7' },
  { id: 'PLS2Ow3V_Wvgc', thumbnail: '/nc500.webp', category: 'ROAD TRIPS', title: 'NC500 - Short Stories of our Trip in 2026' },
  { id: 'PLqKCYKuFxHzSwfwCyrjiggLiinT6kh3jW', thumbnail: '/alps.webp', category: 'ROAD TRIPS', title: 'Conquering the Alps in a Porsche Boxster S (Rain, Passes & Tunnels)' },
  { id: 'PLU8TbHwHtpfQ', thumbnail: '/mgb.webp', category: 'DRIVES, FIXES & UPGRADES', title: '1981 MGB GT LE : Real-World Drives, Fixes & Upgrades' },
  { id: 'PLqKCYKuFxHzRLgngvcRlu-qDL_IZVlUOd', thumbnail: '/mathewsons.webp', category: 'AT THE AUCTIONS', title: 'Mathewsons Auction Sales | Bargains, Bids & Dilemmas' },
];
const tiktok = 'https://www.tiktok.com/@challengingclassics';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Challenging Classics | Classic cars. Fresh challenges.</title>
    <meta name="description" content="Welcome to Challenging Classics. Follow our classic car adventures on YouTube and TikTok, and join a community that loves cars with character." />
    <meta name="theme-color" content="#141a1b" />
    <meta property="og:title" content="Challenging Classics" />
    <meta property="og:description" content="Classic cars. Fresh challenges. Follow the journey." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://challengingclassics.com/logo.png" />
    <link rel="canonical" href="https://challengingclassics.com/" />
    <link rel="icon" type="image/png" href="/logo.png" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <a class="brand" href="/" aria-label="Challenging Classics home"><img src="/logo.png" width="78" height="58" alt="Challenging Classics" /><span>CHALLENGING<br />CLASSICS<span class="brand-dot">.</span></span></a>
      <nav aria-label="Main navigation"><a href="#watch">Watch</a><a href="#about">The channel</a><a class="nav-cta" target="_blank" rel="noopener noreferrer" href={youtube}>YouTube <span aria-hidden="true">↗</span></a></nav>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy"><p class="eyebrow"><span class="status"></span> CARS WITH CHARACTER. STORIES WORTH SHARING.</p><h1 id="hero-title">Classic cars.<br />Fresh <em>challenges.</em></h1><p class="intro">Two blokes from Hertfordshire. Cars with a story.<br class="desktop-break" /> Join Ian &amp; Gav for repairs, road trips and auction adventures.</p><div class="actions"><a class="button primary" target="_blank" rel="noopener noreferrer" href={youtube}><span aria-hidden="true">▶</span> Watch on YouTube <span aria-hidden="true">↗</span></a><a class="text-link" href="#about">Meet the channel <span aria-hidden="true">↓</span></a></div><p class="hero-note">FROM THE GARAGE TO YOUR SCREEN</p></div>
        <div class="hero-art"><div class="orbit"></div><span class="art-top">THE CHALLENGING CLASSICS CHANNEL</span><img src="/logo.png" alt="Challenging Classics illustrated red and turquoise classic sports cars" width="660" height="486" fetchpriority="high" /><div class="art-bottom"><span>OLD-SCHOOL SOUL.</span><span>FULL-THROTTLE ENTHUSIASM.</span></div></div>
      </section>
      <div class="ticker" aria-hidden="true"><span>CLASSIC CARS</span><b>✦</b><span>FRESH CHALLENGES</span><b>✦</b><span>FOLLOW THE JOURNEY</span><b>✦</b><span>CHALLENGING CLASSICS</span><b>✦</b></div>
      <section class="featured section" aria-labelledby="featured-title"><div class="section-head"><div><p class="eyebrow">FROM THE CHANNEL</p><h2 id="featured-title">Real cars. Proper adventures.</h2></div><a class="text-link" target="_blank" rel="noopener noreferrer" href={`${youtube}playlists`}>All playlists <span aria-hidden="true">↗</span></a></div><div class="video-grid">{playlists.map(playlist => <a class="video" target="_blank" rel="noopener noreferrer" href={`https://www.youtube.com/playlist?list=${playlist.id}`}><div class="video-image"><img src={playlist.thumbnail} width="1365" height="768" alt={playlist.title} loading="lazy" /><span aria-hidden="true">▶</span></div><p class="eyebrow">{playlist.category}</p><h3>{playlist.title}</h3><span class="video-link" style="display:inline-block;margin-top:16px">Watch playlist on YouTube ↗</span></a>)}</div></section>
      <section class="watch section" id="watch"><div class="section-head"><div><p class="eyebrow">01 / PRESS PLAY</p><h2>Your next rabbit hole.</h2></div><p>Big-screen viewing or a quick pit stop.<br />Find us wherever you like to watch.</p></div><div class="channel-grid"><a class="channel youtube" target="_blank" rel="noopener noreferrer" href={youtube}><div class="channel-top"><span class="platform-icon" aria-hidden="true">▶</span><span class="tag">THE FULL EXPERIENCE</span></div><div><h3>Pull up a seat.<br />Stay for the classics.</h3><p>Explore the channel, find your next watch and follow the journey on YouTube.</p></div><span class="channel-bottom">Explore YouTube <span aria-hidden="true">↗</span></span></a><a class="channel tiktok" target="_blank" rel="noopener noreferrer" href={tiktok}><div class="channel-top"><span class="platform-icon music" aria-hidden="true">♪</span><span class="tag">A QUICK PIT STOP</span></div><div><h3>A little more<br />classic in your feed.</h3><p>Catch Challenging Classics on TikTok. Quick watches, straight to your feed.</p></div><span class="channel-bottom">Find us on TikTok <span aria-hidden="true">↗</span></span></a></div></section>
      <section class="about section" id="about"><div class="about-label"><p class="eyebrow">02 / THE CHANNEL</p><span class="outline-number" aria-hidden="true">CC.</span></div><div><h2>Some cars just<br />get under your skin.</h2><p class="about-lead">The shapes. The sounds. The character. There’s something about a classic that keeps you coming back.</p><p>We’re Ian &amp; Gav, two blokes from Hertfordshire sharing the fun and challenge of classic cars. The plan? Buy interesting cars from the ’70s through the noughties, repair and recommission where needed, then get out and enjoy them. From Boxster jobs in the garage to the NC500 and the Pyrenees, come and see where the next challenge takes us.</p><a class="text-link" target="_blank" rel="noopener noreferrer" href={youtube}>Come along for the ride <span aria-hidden="true">↗</span></a></div></section>
      <section class="join section"><p class="eyebrow">THERE’S ALWAYS ANOTHER CHALLENGE.</p><h2>Don’t miss<br />the next chapter.</h2><p>Subscribe on YouTube and follow us on TikTok.<br />We’ll see you there.</p><a class="button primary" target="_blank" rel="noopener noreferrer" href={`${youtube}?sub_confirmation=1`}>Subscribe on YouTube <span aria-hidden="true">↗</span></a></section>
    </main>
    <footer><a class="footer-brand" href="/">CHALLENGING CLASSICS<span>.</span></a><div><a target="_blank" rel="noopener noreferrer" href={youtube}>YouTube ↗</a><a target="_blank" rel="noopener noreferrer" href={tiktok}>TikTok ↗</a><a target="_blank" rel="noopener noreferrer" href={facebook}>Facebook ↗</a><a target="_blank" rel="noopener noreferrer" href={instagram}>Instagram ↗</a></div><p>© {new Date().getFullYear()} Challenging Classics</p></footer>
  </body>
</html>
